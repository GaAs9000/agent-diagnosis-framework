{
  "mode": "analyst",
  "model": {
    "adapter": "openai-compatible",
    "kind": "local",
    "model": "Qwen/Qwen2.5-32B-Instruct",
    "api_key_env": null,
    "base_url": "http://127.0.0.1:8000/v1",
    "parameters": {
      "temperature": 0,
      "max_tokens": 8192
    }
  },
  "budget": {
    "max_analyst_requests": 10,
    "max_retrieval_bytes": 1048576,
    "wall_time_seconds": 300
  }
}
