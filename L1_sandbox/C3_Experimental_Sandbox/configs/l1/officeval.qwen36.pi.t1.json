    "image": "l1-office:0.2.0",
    "outcome_policy": "official_dimensions"
  },
  "budget": {
    "max_model_requests": 35,
    "max_tool_calls": 140,
    "wall_time_seconds": 10800,
    "max_total_tokens": null
  },
  "recording": {
    "checkpoints": true,
    "objects": false
  },
  "plugins": {
    "load_installed": true
  },
  "agent": {
    "name": "pi-coding-agent",
