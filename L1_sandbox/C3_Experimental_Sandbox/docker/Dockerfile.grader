ARG PYTHON_BASE=python:3.12-slim
FROM ${PYTHON_BASE}
RUN groupadd --gid 1000 sandbox && useradd --uid 1000 --gid 1000 --no-create-home sandbox \
    && mkdir /workspace /opt/grader && chown 1000:1000 /workspace
COPY grader.py /opt/grader/grader.py
RUN printf '7\n' > /opt/grader/expected.json && chmod 0444 /opt/grader/* && chmod 0555 /opt/grader
USER 1000:1000
WORKDIR /workspace
CMD ["sleep", "infinity"]
