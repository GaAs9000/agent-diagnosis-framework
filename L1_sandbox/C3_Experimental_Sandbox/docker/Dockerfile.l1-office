# Build once locally. L1 records and executes the resolved image ID, never a mutable tag mid-episode.
ARG BASE_IMAGE=python:3.12-slim-bookworm
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer libreoffice-calc libreoffice-impress poppler-utils \
    fonts-noto-cjk fonts-liberation libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY docker/requirements.l1-office.txt /opt/l1/requirements.txt
RUN pip install --no-cache-dir -r /opt/l1/requirements.txt && pip freeze > /opt/l1/pip-freeze.txt
COPY src/c3_sandbox/l1/evaluation/worker.py /opt/l1/grade_worker.py
RUN chmod -R a-w /opt/l1 && mkdir -p /workspace && chmod 1777 /workspace
ENV HOME=/tmp PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMEGAUSE_OFFICEVAL_DISABLE_COM=1
USER 65532:65532
WORKDIR /workspace
CMD ["/bin/sh"]
